# ============================================================================
# .editorconfig — 편집기 공통 서식 규칙
#
# 동작: VS Code, PyCharm 등 대부분의 편집기가 이 파일을 자동 인식해서
#       파일을 저장할 때 아래 규칙(들여쓰기, 줄바꿈 등)을 적용한다.
#
# DevOps 관점에서 왜 필요한가?
#   - 팀원마다 편집기 설정이 다르면 "탭 vs 스페이스", "줄끝 공백" 같은
#     의미 없는 변경이 diff에 섞여 코드 리뷰를 방해한다.
#   - 특히 YAML(들여쓰기가 곧 문법)과 Makefile(탭 필수)은 서식이 틀리면
#     동작 자체가 깨지므로, 규칙을 레포 차원에서 강제한다.
#
# ⚠️ 주의: EditorConfig는 값 뒤의 인라인 주석을 지원하지 않는다 — 설명은 별도 줄에.
# ============================================================================

# "이 파일이 최상위 설정"이라는 선언 — 상위 폴더의 .editorconfig를 더 찾지 않는다
root = true

# ── 모든 파일에 적용되는 기본 규칙 ──────────────────────────────────────────
[*]
# 문자 인코딩 통일 (한글 주석 깨짐 방지)
charset = utf-8
# 줄바꿈은 LF(유닉스식) — Windows CRLF가 섞이면 셸 스크립트/컨테이너에서 깨진다
end_of_line = lf
# 파일 끝에 빈 줄 하나 (POSIX 표준, git diff 노이즈 방지)
insert_final_newline = true
# 줄 끝 공백 자동 제거
trim_trailing_whitespace = true
# 들여쓰기: 스페이스 4칸 (Python 표준)
indent_style = space
indent_size = 4

# ── YAML: 2칸 들여쓰기 (쿠버네티스 매니페스트 관례, CLAUDE.md Conventions) ──
[*.{yml,yaml}]
indent_size = 2

# ── Markdown: 줄 끝 공백 2개가 "줄바꿈" 문법이므로 자동 제거하면 안 된다 ────
[*.md]
trim_trailing_whitespace = false

# ── Makefile: 명령 줄은 반드시 탭 (스페이스면 make가 에러) — 예외 규칙 ──────
[Makefile]
indent_style = tab

# ── 셸 스크립트: 2칸 들여쓰기 (셸 커뮤니티 관례) ────────────────────────────
[*.sh]
indent_size = 2
