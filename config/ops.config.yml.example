# ============================================================================
# ops.config.yml.example — 조직별 설정값 템플릿 (ai-ops-harness 형식)
#
# 사용법:
#   1. 이 파일을 복사한다: cp config/ops.config.yml.example config/ops.config.yml
#   2. 복사본(ops.config.yml)에 실제 값을 채운다.
#
# DevOps 관점: 왜 example 파일만 커밋하는가?
#   - 실제 값 파일(ops.config.yml)은 .gitignore에 등록되어 커밋되지 않는다.
#     조직 내부 정보(채널명, URL 등)를 공개 저장소에 남기지 않기 위함이다.
#   - 대신 example로 "어떤 키가 필요한지" 구조만 공유한다.
#     새 팀원은 이 템플릿을 복사해 자기 환경 값만 채우면 된다.
#   - .env / .env.example 관계와 같은 패턴 (CLAUDE.md Security Rules 참고).
# ============================================================================

# ── 조직 정보 ───────────────────────────────────────────────────────────────
org:
  team_name: "seemedi"           # 팀 식별자 — 자동화 스크립트가 리소스 이름에 사용
  github_org: "SEEMEDI"          # GitHub 조직 이름 — 레포 경로 조합에 사용

# ── 관련 레포 경로 ──────────────────────────────────────────────────────────
repos:
  infra: "SEEMEDI/infra"           # 인프라(IaC) 레포 — 프로덕션 전환 시 사용 예정
  app: "SEEMEDI/k8s-local-lab"     # 이 레포

# ── 환경별 접속 정보 ────────────────────────────────────────────────────────
# 배포/점검 자동화가 "어느 환경의 어느 주소로" 접근할지 결정하는 값들.
environments:
  local_url: "http://app.localhost"      # 로컬 Ingress 주소 (manifests/app/ingress.yml의 host)
  staging_url: ""                        # TODO: 스테이징 환경 구축 후 채우기
  prod_url: ""                           # TODO: 프로덕션 환경 구축 후 채우기
  cluster_local: "k3d-seemedi-local"     # 로컬 kubectl 컨텍스트 이름 (cluster-create.sh가 생성)
  cluster_staging: ""                    # TODO: 스테이징 클러스터 컨텍스트
  cluster_prod: ""                       # TODO: 프로덕션 클러스터 컨텍스트

# ── 컨테이너 레지스트리 ─────────────────────────────────────────────────────
# 프로덕션에서 이미지를 push/pull할 저장소.
# 로컬은 k3d image import(make load)를 쓰므로 아직 사용하지 않는다.
# (참고: docs/05-production-mapping.md — 레지스트리 행)
registry:
  container: "ghcr.io/seemedi"

# ── 알림/온콜 ───────────────────────────────────────────────────────────────
# 장애 대응 자동화(/incident-triage 등)가 참조할 채널 정보.
alerts:
  incident_channel: ""                   # TODO: Slack 채널 설정 후 채우기 (예: "#incident")
  oncall_handle: ""                      # TODO: 온콜 담당자 멘션 핸들 (예: "@oncall")
